[
  {
    "name": "@lsw-abpvue/utils",
    "path": "packages/utils/dist/index.js",
    "limit": "1 kB"
  },
  {
    "name": "@lsw-abpvue/core",
    "path": "packages/core/dist/index.js",
    "ignore": ["vue"],
    "limit": "12 kB"
  },
  {
    "name": "@lsw-abpvue/core (only defineToken)",
    "path": "packages/core/dist/index.js",
    "import": "{ defineToken }",
    "ignore": ["vue"],
    "limit": "200 B"
  },
  {
    "name": "@lsw-abpvue/core/router",
    "path": "packages/core/dist/router/index.js",
    "ignore": ["vue", "vue-router", "@lsw-abpvue/core"],
    "limit": "3 kB"
  },
  {
    "name": "@lsw-abpvue/oauth",
    "path": "packages/oauth/dist/index.js",
    "ignore": ["vue", "vue-router", "@lsw-abpvue/core", "oidc-client-ts"],
    "limit": "6 kB"
  },
  {
    "name": "@lsw-abpvue/theme-shared",
    "path": "packages/theme-shared/dist/index.js",
    "ignore": ["vue", "@lsw-abpvue/core"],
    "limit": "6 kB"
  },
  {
    "name": "@lsw-abpvue/theme-basic",
    "path": "packages/theme-basic/dist/index.js",
    "ignore": ["vue", "vue-router", "@lsw-abpvue/core", "@lsw-abpvue/theme-shared", "reka-ui"],
    "limit": "12 kB"
  }
]

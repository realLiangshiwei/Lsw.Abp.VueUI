# The e2e backend in `e2e/backend/BookStore`. Override in `.env.local`, or deploy a
# `public/dynamic-env.json` next to the build, which wins over this.
VITE_API_URL=https://localhost:44384

# The password flow, so the account module's own pages are the ones on screen. Set it to
# `code` in `.env.local` to hand the visitor to the identity server instead -- the
# account pages then redirect there, which is what `authenticationFlowGuard` is for.
VITE_AUTH_RESPONSE_TYPE=password

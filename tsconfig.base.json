{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "preserve",
    "types": [],

    "paths": {
      "@lsw-abpvue/account": ["./packages/account/src/index.ts"],
      "@lsw-abpvue/account/config": ["./packages/account/config/src/index.ts"],
      "@lsw-abpvue/account-core": ["./packages/account-core/src/index.ts"],
      "@lsw-abpvue/account-core/proxy": ["./packages/account-core/proxy/src/index.ts"],
      "@lsw-abpvue/cli": ["./packages/cli/src/index.ts"],
      "@lsw-abpvue/components": ["./packages/components/src/index.ts"],
      "@lsw-abpvue/components/extensible": ["./packages/components/extensible/src/index.ts"],
      "@lsw-abpvue/core": ["./packages/core/src/index.ts"],
      "@lsw-abpvue/core/router": ["./packages/core/router/src/index.ts"],
      "@lsw-abpvue/identity": ["./packages/identity/src/index.ts"],
      "@lsw-abpvue/identity/config": ["./packages/identity/config/src/index.ts"],
      "@lsw-abpvue/identity/proxy": ["./packages/identity/proxy/src/index.ts"],
      "@lsw-abpvue/oauth": ["./packages/oauth/src/index.ts"],
      "@lsw-abpvue/permission-management": ["./packages/permission-management/src/index.ts"],
      "@lsw-abpvue/permission-management/proxy": [
        "./packages/permission-management/proxy/src/index.ts"
      ],
      "@lsw-abpvue/setting-management": ["./packages/setting-management/src/index.ts"],
      "@lsw-abpvue/setting-management/config": [
        "./packages/setting-management/config/src/index.ts"
      ],
      "@lsw-abpvue/setting-management/proxy": ["./packages/setting-management/proxy/src/index.ts"],
      "@lsw-abpvue/theme-basic": ["./packages/theme-basic/src/index.ts"],
      "@lsw-abpvue/theme-shared": ["./packages/theme-shared/src/index.ts"],
      "@lsw-abpvue/theme-shared/testing": ["./packages/theme-shared/testing/src/index.ts"],
      "@lsw-abpvue/utils": ["./packages/utils/src/index.ts"]
    }
  }
}

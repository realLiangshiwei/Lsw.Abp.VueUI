{
  "name": "@lsw-abpvue/core",
  "version": "0.0.1-alpha.4",
  "description": "The kernel of the ABP Vue UI: dependency injection, application state, localization and routing.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "router/src",
    "object-extensions/src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./package.json": "./package.json",
    "./object-extensions": {
      "types": "./dist/object-extensions/index.d.ts",
      "import": "./dist/object-extensions/index.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && vue-tsc -p tsconfig.build.router.json && vue-tsc -p tsconfig.build.object-extensions.json && node ../../scripts/rewrite-vue-declarations.mjs dist",
    "typecheck": "vue-tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "@lsw-abpvue/utils": "workspace:^",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@lsw-abpvue/utils": "workspace:*",
    "vue": "^3.5.41",
    "vue-router": "^4.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realLiangshiwei/Lsw.Abp.VueUI.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/realLiangshiwei/Lsw.Abp.VueUI",
  "bugs": "https://github.com/realLiangshiwei/Lsw.Abp.VueUI/issues",
  "keywords": [
    "abp",
    "vue",
    "dependency-injection"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  }
}

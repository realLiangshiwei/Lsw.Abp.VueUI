{
  "name": "@lsw-abpvue/core",
  "version": "0.0.0",
  "description": "The kernel of the ABP Vue UI: dependency injection, application state, localization and routing.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "^3.5.41"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realLiangshiwei/Lsw.Abp.VueUI.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/realLiangshiwei/Lsw.Abp.VueUI",
  "bugs": "https://github.com/realLiangshiwei/Lsw.Abp.VueUI/issues",
  "keywords": [
    "abp",
    "vue",
    "dependency-injection"
  ],
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@lsw-abpvue/account-pro",
  "version": "0.1.0",
  "description": "Account Pro authentication, profile, security and administration for ABP Vue applications.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "config/src",
    "proxy/src",
    "README.md",
    "admin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "import": "./dist/proxy/index.js"
    },
    "./package.json": "./package.json",
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    },
    "./admin/config": {
      "types": "./dist/admin/config/index.d.ts",
      "import": "./dist/admin/config/index.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.proxy.json && vue-tsc -p tsconfig.build.config.json && vue-tsc -p tsconfig.build.json && vue-tsc -p tsconfig.build.admin.json && vue-tsc -p tsconfig.build.admin-config.json && node ../../scripts/rewrite-vue-declarations.mjs dist",
    "typecheck": "vue-tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "@lsw-abpvue/account": "workspace:^",
    "@lsw-abpvue/account-core": "workspace:^",
    "@lsw-abpvue/components": "workspace:^",
    "@lsw-abpvue/core": "workspace:^",
    "@lsw-abpvue/setting-management": "workspace:^",
    "@lsw-abpvue/theme-shared": "workspace:^",
    "qrcode": "1.5.4",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@lsw-abpvue/account": "workspace:^",
    "@lsw-abpvue/account-core": "workspace:*",
    "@lsw-abpvue/components": "workspace:*",
    "@lsw-abpvue/core": "workspace:*",
    "@lsw-abpvue/setting-management": "workspace:^",
    "@lsw-abpvue/theme-shared": "workspace:*",
    "@types/qrcode": "1.5.6",
    "qrcode": "1.5.4",
    "vue": "3.5.41",
    "vue-router": "^4.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realLiangshiwei/Lsw.Abp.VueUI.git",
    "directory": "packages/account-pro"
  },
  "publishConfig": {
    "access": "public"
  }
}

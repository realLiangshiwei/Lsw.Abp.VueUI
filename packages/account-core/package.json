{
  "name": "@lsw-abpvue/account-core",
  "version": "0.0.0",
  "description": "What the account pages and the theme both need, with no UI of its own: the tenant box, the login schemes a client allows, and the tabs of the profile page.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "proxy/src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "import": "./dist/proxy/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.proxy.json && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "@lsw-abpvue/core": "workspace:^",
    "@lsw-abpvue/utils": "workspace:^",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@lsw-abpvue/core": "workspace:*",
    "@lsw-abpvue/utils": "workspace:*",
    "vue": "^3.5.41",
    "vue-router": "^4.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realLiangshiwei/Lsw.Abp.VueUI.git",
    "directory": "packages/account-core"
  },
  "homepage": "https://github.com/realLiangshiwei/Lsw.Abp.VueUI",
  "bugs": "https://github.com/realLiangshiwei/Lsw.Abp.VueUI/issues",
  "keywords": [
    "abp",
    "vue",
    "account"
  ],
  "publishConfig": {
    "access": "public"
  }
}

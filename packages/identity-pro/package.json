{
  "name": "@lsw-abpvue/identity-pro",
  "version": "0.1.0",
  "description": "The Identity Pro module UI for ABP Vue applications.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "config/src",
    "proxy/src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "import": "./dist/proxy/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.proxy.json && vue-tsc -p tsconfig.build.config.json && vue-tsc -p tsconfig.build.json && node ../../scripts/rewrite-vue-declarations.mjs dist",
    "typecheck": "vue-tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "@lsw-abpvue/components": "workspace:^",
    "@lsw-abpvue/core": "workspace:^",
    "@lsw-abpvue/identity": "workspace:^",
    "@lsw-abpvue/permission-management": "workspace:^",
    "@lsw-abpvue/theme-shared": "workspace:^",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "@lsw-abpvue/setting-management": "workspace:^",
    "@lsw-abpvue/audit-logging": "workspace:^",
    "@lsw-abpvue/account-pro": "workspace:^"
  },
  "devDependencies": {
    "@lsw-abpvue/components": "workspace:*",
    "@lsw-abpvue/core": "workspace:*",
    "@lsw-abpvue/identity": "workspace:*",
    "@lsw-abpvue/permission-management": "workspace:*",
    "@lsw-abpvue/theme-shared": "workspace:*",
    "vue": "3.5.41",
    "vue-router": "^4.5.1",
    "@lsw-abpvue/setting-management": "workspace:*",
    "@lsw-abpvue/audit-logging": "workspace:*",
    "@lsw-abpvue/account-pro": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realLiangshiwei/Lsw.Abp.VueUI.git",
    "directory": "packages/identity-pro"
  },
  "publishConfig": {
    "access": "public"
  }
}

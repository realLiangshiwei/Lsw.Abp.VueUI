{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tsconfig*.json",
        "vite.config.ts",
        "$TURBO_ROOT$/scripts/bundle-template.mjs",
        "$TURBO_ROOT$/templates/app/**"
      ],
      "outputs": ["dist/**"]
    }
  }
}

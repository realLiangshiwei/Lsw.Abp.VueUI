{
  "name": "@lsw-abpvue/components",
  "version": "0.1.0",
  "description": "The extension system of the ABP Vue UI: five extension points, the object extension mapping, and the extensible table and form.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "extensible/src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extensible": {
      "types": "./dist/extensible/index.d.ts",
      "import": "./dist/extensible/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && vue-tsc -p tsconfig.build.extensible.json && node ../../scripts/rewrite-vue-declarations.mjs dist",
    "typecheck": "vue-tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@tanstack/vue-table": "^8.21.3"
  },
  "peerDependencies": {
    "@lsw-abpvue/core": "workspace:^",
    "@lsw-abpvue/theme-shared": "workspace:^",
    "@lsw-abpvue/utils": "workspace:^",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@lsw-abpvue/core": "workspace:*",
    "@lsw-abpvue/theme-shared": "workspace:*",
    "@lsw-abpvue/utils": "workspace:*",
    "vue": "^3.5.41"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realLiangshiwei/Lsw.Abp.VueUI.git",
    "directory": "packages/components"
  },
  "homepage": "https://github.com/realLiangshiwei/Lsw.Abp.VueUI",
  "bugs": "https://github.com/realLiangshiwei/Lsw.Abp.VueUI/issues",
  "keywords": [
    "abp",
    "vue",
    "extensible"
  ],
  "publishConfig": {
    "access": "public"
  }
}

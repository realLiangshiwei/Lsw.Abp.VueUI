{
  "name": "@lsw-abpvue/permission-management",
  "version": "0.0.1-alpha.4",
  "description": "The permission grant dialog of the ABP Vue UI: the grouped tree, select all, and what a permission granted somewhere else looks like.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "proxy/src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "import": "./dist/proxy/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.proxy.json && vue-tsc -p tsconfig.build.json && node ../../scripts/rewrite-vue-declarations.mjs dist",
    "typecheck": "vue-tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "@lsw-abpvue/components": "workspace:^",
    "@lsw-abpvue/core": "workspace:^",
    "@lsw-abpvue/theme-shared": "workspace:^",
    "@lsw-abpvue/utils": "workspace:^",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@lsw-abpvue/components": "workspace:*",
    "@lsw-abpvue/core": "workspace:*",
    "@lsw-abpvue/theme-shared": "workspace:*",
    "@lsw-abpvue/utils": "workspace:*",
    "vue": "^3.5.41"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realLiangshiwei/Lsw.Abp.VueUI.git",
    "directory": "packages/permission-management"
  },
  "homepage": "https://github.com/realLiangshiwei/Lsw.Abp.VueUI",
  "bugs": "https://github.com/realLiangshiwei/Lsw.Abp.VueUI/issues",
  "keywords": [
    "abp",
    "vue",
    "permissions"
  ],
  "publishConfig": {
    "access": "public"
  }
}

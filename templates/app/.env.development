# The second of the three levels `loadRuntimeConfig` walks, after `public/dynamic-env.json`
# and before the built-in defaults in `src/env.ts`. Machine-local overrides go in
# `.env.development.local`, which is not committed.
VITE_API_URL=__API_URL__
VITE_AUTH_URL=__AUTH_URL__
VITE_APP_URL=__APP_URL__

{
  "name": "@lsw-abpvue/template-lib",
  "version": "0.1.0",
  "private": true,
  "description": "The Vue UI of the Sample ABP module.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "config/src",
    "proxy/src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "import": "./dist/proxy/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.proxy.json && vue-tsc -p tsconfig.build.config.json && vue-tsc -p tsconfig.build.json && node scripts/rewrite-vue-declarations.mjs dist",
    "typecheck": "vue-tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "@lsw-abpvue/components": "workspace:^",
    "@lsw-abpvue/core": "workspace:^",
    "@lsw-abpvue/theme-shared": "workspace:^",
    "@lsw-abpvue/utils": "workspace:^",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@lsw-abpvue/components": "workspace:*",
    "@lsw-abpvue/core": "workspace:*",
    "@lsw-abpvue/theme-shared": "workspace:*",
    "@lsw-abpvue/utils": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.3.9"
  },
  "publishConfig": {
    "access": "public"
  }
}

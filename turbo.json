{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "*/src/**",
        "index.html",
        "vite.config.ts",
        "tsconfig*.json",
        "*.md",
        "**/*.md",
        ".vitepress/**"
      ],
      "outputs": ["dist/**", ".vitepress/dist/**"]
    },
    "@lsw-abpvue/cli#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/templates/**",
        "!$TURBO_ROOT$/templates/**/node_modules/**",
        "!$TURBO_ROOT$/templates/**/dist/**",
        "!$TURBO_ROOT$/templates/**/.turbo/**",
        "$TURBO_ROOT$/scripts/bundle-template.mjs"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

{
  "name": "lsw-abp-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "check:external-install": "./scripts/check-external-install.sh",
    "check:published-types": "./scripts/check-published-types.sh",
    "check:resolution": "./scripts/check-resolution.sh",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "prepare": "lefthook install",
    "size": "size-limit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -p tsconfig.json && turbo run typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.6",
    "lefthook": "^2.1.10",
    "pkg-pr-new": "^0.0.88",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "size-limit": "^12.1.0",
    "turbo": "^2.10.11",
    "typescript": "6.0.3",
    "typescript-downstream": "npm:typescript@5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  }
}
